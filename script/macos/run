#!/bin/bash
#
# macOS-specific implementation of `./script/run`. Runs a local version of
# Twarp as a real app instead of a bare executable, so macOS can treat it
# like a real signed app (custom URL schemes, user notifications, etc.).
#
# This script is invoked by `./script/run`, which handles cross-platform
# setup (install_channel_config, binary name detection, feature-to-env-var
# mapping). The following env vars are expected to be set by the caller:
#   WARP_BIN_NAME  — "twarp" (internal local build) or "twarp-oss"
#   WARP_CHANNEL   — "local" or "oss"
#   FEATURES       — comma-separated cargo features (already normalized)
# Must be called from the root directory of the twarp repo.

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
cd "${REPO_ROOT}"

: "${WARP_BIN_NAME:?WARP_BIN_NAME must be set (invoke via ./script/run)}"
: "${WARP_CHANNEL:?WARP_CHANNEL must be set (invoke via ./script/run)}"
: "${FEATURES:?FEATURES must be set (invoke via ./script/run)}"

# Resolve Cargo's actual target directory rather than assuming ./target. This
# honors a shared CARGO_TARGET_DIR / build.target-dir (e.g. set in
# ~/.cargo/config.toml), which is where `cargo bundle` writes the .app bundle.
TARGET_DIR="$(cargo metadata --no-deps --format-version 1 | jq -r .target_directory)"
if [ -z "$TARGET_DIR" ] || [ "$TARGET_DIR" = "null" ]; then
    TARGET_DIR="${REPO_ROOT}/target"
fi

if [ "$WARP_CHANNEL" = "local" ]; then
    WARP_APP_PATH="${TARGET_DIR}/debug/bundle/osx/TwarpLocal.app"
    WARP_SCHEME_NAME="warplocal"
else
    WARP_APP_PATH="${TARGET_DIR}/debug/bundle/osx/TwarpOss.app"
    WARP_SCHEME_NAME="warposs"
fi
DONT_OPEN=false
# twarp: when --install is passed, the freshly built + signed bundle is also
# copied to /Applications/<AppName>.app after the build. `./script/run` otherwise
# only produces the bundle under target/<profile>/bundle, which is a SEPARATE
# copy from any /Applications install that shares the same bundle id — so a
# rebuild here is invisible to a Dock/Spotlight launch until you reinstall. With
# --install, Dock/Spotlight launches pick up the new code.
INSTALL=false
# Launches the binary with "open", meaning the Twarp process is
# launched by the MacOS application launcher instead of a shell session.
# Note that since Twarp isn't launched as a child process, using ctrl+c
# won't kill the app (but will kill the tail process displaying output).
# tl;dr better simulates running Twarp Dev/Stable
OPEN_WITH_LAUNCHD=false

# Arguments to pass directly to Twarp (specified after --)
# This is not supported when opening with launchd, as passing CLI arguments to
# an application doesn't make sense.
WARP_ARGS=()

# Export this variable so it can be referenced by app/build.rs later when
# running `cargo bundle`.
export FRAMEWORK_OVERRIDE="dev"

PARAMS=""
while (( "$#" )); do
  case "$1" in
    --)
      shift
      WARP_ARGS=("$@")
      break
      ;;
    --dont-open)
      DONT_OPEN=true
      shift
      ;;
    --release)
      echo "Detected release build, pointing at release bundle under ${TARGET_DIR}/release/bundle"
      if [ "$WARP_CHANNEL" = "local" ]; then
          WARP_APP_PATH="${TARGET_DIR}/release/bundle/osx/TwarpLocal.app"
      else
          WARP_APP_PATH="${TARGET_DIR}/release/bundle/osx/TwarpOss.app"
      fi
      PARAMS="$PARAMS $1"
      shift
      ;;
    --profile)
      PROFILE="$2"
      shift 2
      if [ "$WARP_CHANNEL" = "local" ]; then
          WARP_APP_PATH="${TARGET_DIR}/${PROFILE}/bundle/osx/TwarpLocal.app"
      else
          WARP_APP_PATH="${TARGET_DIR}/${PROFILE}/bundle/osx/TwarpOss.app"
      fi
      PARAMS="$PARAMS --profile $PROFILE"
      ;;
    --open_with_launchd)
      OPEN_WITH_LAUNCHD=true
      shift
      ;;
    --generate-schema)
      GENERATE_SCHEMA=true
      shift
      ;;
    --install)
      INSTALL=true
      shift
      ;;
    *) # preserve positional arguments
      PARAMS="$PARAMS $1"
      shift
      ;;
  esac
done

rm -rf "$WARP_APP_PATH"

pushd app > /dev/null
echo "Bundling app (bin: $WARP_BIN_NAME)..."
cargo bundle --bin "$WARP_BIN_NAME" --features "$FEATURES" $PARAMS
echo "Successfully bundled..."
popd > /dev/null

echo "Adding rpath to support mac frameworks"
install_name_tool -add_rpath "@executable_path/../Frameworks" "$WARP_APP_PATH/Contents/MacOS/$WARP_BIN_NAME"

export WARP_SCHEME_NAME
export WARP_PLIST_PATH="$WARP_APP_PATH/Contents/Info.plist"
./script/update_plist

echo "Preparing bundled resources..."
if [ "${GENERATE_SCHEMA:-false}" != "true" ]; then
  export SKIP_SETTINGS_SCHEMA=1
fi
NO_LICENSES=1 "${REPO_ROOT}/script/prepare_bundled_resources" "$WARP_APP_PATH/Contents/Resources" "$WARP_CHANNEL"

"${REPO_ROOT}/script/compile_icon" "$WARP_CHANNEL" "$WARP_APP_PATH"

if [[ ",$FEATURES," =~ ",heap_usage_tracking," ]]; then
  echo "Bundling pprof..."
  HELPERS_DIR="$WARP_APP_PATH/Contents/Helpers"
  "${REPO_ROOT}/script/prepare_bundled_pprof" "$HELPERS_DIR"
fi

echo "Codesigning app..."
# Pick a STABLE signing identity so macOS keychain "Always Allow" persists
# across rebuilds. The code signature's designated requirement is keyed to the
# signing cert's subject CN, so signing with a different cert each build changes
# the requirement and re-triggers the per-launch keychain password prompt.
# Prefer a Developer ID Application cert (the cert intended for apps run outside
# Xcode — stable, Gatekeeper-friendly), then fall back to an Apple Development
# cert, then ad-hoc ("-"). Override explicitly with WARP_SIGNING_IDENTITY.
#
# When multiple teams' certs are in the keychain, the pick must also be
# deterministic: an identity from a DIFFERENT team than the previous build
# changes the designated requirement, and every keychain item the old build
# wrote (API keys, etc.) becomes ACL-orphaned for the new one. Pin the team
# with WARP_SIGNING_TEAM to keep debug and release builds on one identity.
IDENTITIES="$(security find-identity -p codesigning -v)"
if [ -n "${WARP_SIGNING_TEAM:-}" ]; then
    IDENTITIES="$(echo "$IDENTITIES" | grep "(${WARP_SIGNING_TEAM})")"
fi
pick_identity() {
    echo "$IDENTITIES" | grep "$1" | awk '{print $2}' | sort | head -1
}
SIGNING_CERT="${WARP_SIGNING_IDENTITY:-$(pick_identity "Developer ID Application")}"
if [ -z "$SIGNING_CERT" ]; then
    SIGNING_CERT="$(pick_identity "Apple Development")"
fi
if [ -z "$SIGNING_CERT" ]; then
    echo "WARNING: no signing identity found${WARP_SIGNING_TEAM:+ for team ${WARP_SIGNING_TEAM}} — signing ad-hoc." >&2
    echo "WARNING: ad-hoc signatures change every build, so keychain items (saved API keys) will not survive rebuilds." >&2
fi
echo "Signing with identity: ${SIGNING_CERT:--} (ad-hoc if '-')"
codesign --force --deep --options runtime --sign "${SIGNING_CERT:--}" "$WARP_APP_PATH" --entitlements script/Debug-Entitlements.plist

if [ "$INSTALL" = true ] ; then
    APP_NAME="$(basename "$WARP_APP_PATH")"
    INSTALL_PATH="/Applications/$APP_NAME"
    echo "Installing $APP_NAME to /Applications (ditto preserves the bundle + signature)..."
    # rm first so files removed in the new build don't linger. macOS unlinks the
    # old bundle safely even if an instance is still running (its mmap'd binary
    # keeps working); the running instance just keeps the OLD code until relaunch.
    rm -rf "$INSTALL_PATH"
    ditto "$WARP_APP_PATH" "$INSTALL_PATH"
    echo "Installed to $INSTALL_PATH — Dock/Spotlight launches will now use this build."
fi

if [ "$DONT_OPEN" = false ] ; then
    if  [ "$OPEN_WITH_LAUNCHD" = true ]; then
        echo "Launching with MacOS application launcher"
        PATH="" /usr/bin/open "$WARP_APP_PATH"
        if [ "$WARP_CHANNEL" = "local" ]; then
            LOG_FILE=~/Library/Logs/twarp_local.log
        elif [ "$WARP_CHANNEL" = "oss" ]; then
            LOG_FILE=~/Library/Logs/twarp-oss.log
        else
            echo "Warning: unrecognized WARP_CHANNEL '$WARP_CHANNEL', defaulting to OSS log path" >&2
            LOG_FILE=~/Library/Logs/twarp-oss.log
        fi
        tail -F "$LOG_FILE"
    else
        echo "Opening app at $WARP_APP_PATH/Contents/MacOS/$WARP_BIN_NAME"
        "$WARP_APP_PATH/Contents/MacOS/$WARP_BIN_NAME" "${WARP_ARGS[@]}"
    fi
fi
